HONEYCHAIN_SECRET=change-this-in-production
HONEYCHAIN_DB=./honeychain.db
# Local development only: backend can pull this LAN sensor every 15s.
HONEYCHAIN_IOT_URL=http://10.192.35.56/
# Production: have the device POST readings to /api/iot/readings instead.
HONEYCHAIN_IOT_KEY=change-this-device-key
# Public HTTPS frontend URL used inside QR codes. Do NOT leave localhost in deployment.
HONEYCHAIN_PUBLIC_BASE_URL=https://honeychain.example.com
FRONTEND_ORIGINS=https://honeychain.example.com,http://localhost:5173,http://127.0.0.1:5173

# Optional production EVM blockchain anchor
HONEYCHAIN_BLOCKCHAIN_RPC_URL=
HONEYCHAIN_BLOCKCHAIN_PRIVATE_KEY=
HONEYCHAIN_BLOCKCHAIN_CONTRACT_ADDRESS=
HONEYCHAIN_BLOCKCHAIN_EXPLORER_URL=
